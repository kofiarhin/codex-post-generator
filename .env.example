# Thumbnail generation
# Use Hugging Face when available; set local to force the built-in fallback renderer.
IMAGE_GENERATION_PROVIDER=huggingface
HF_TOKEN=hf_your_token_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# API server and dashboard
MONGO_URI=mongodb://127.0.0.1:27017/post_generator
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.128:5173
VITE_API_BASE_URL=http://localhost:5000

# Autonomous text-only workflow (disabled until separate activation approval)
# MONGODB_URI remains a supported alias; do not set conflicting URIs.
AUTONOMOUS_PUBLISH_ENABLED=false
BUFFER_API_KEY=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_X_CHANNEL_ID=
